# Copy this to `.env` (gitignored, never commit real values) for local dev
# builds (`npx expo start` / `npx expo run:android`). For `eas build` cloud
# builds, these same three variables must also be set as EAS project
# environment variables instead — see README.md.
EXPO_PUBLIC_TURN_URLS=turn:turn.ashwanitiwari.com:3478,turns:turn.ashwanitiwari.com:5349?transport=tcp
EXPO_PUBLIC_TURN_USERNAME=peerbridge
EXPO_PUBLIC_TURN_CREDENTIAL=
